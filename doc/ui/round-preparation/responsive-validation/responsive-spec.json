{
  "version": 2,
  "scope": "design reference, not production entry point",
  "logicalSize": [
    1280,
    720
  ],
  "minimumRegularWindow": [
    960,
    540
  ],
  "fit": "scale=min((W-L-R)/1280,(H-T-B)/720)",
  "stageOrigin": [
    "L+(W-L-R-1280*scale)/2",
    "T+(H-T-B-720*scale)/2"
  ],
  "input": "reject outside stage; inverse stage transform; cancel held press on resize",
  "environment": "cover whole window",
  "artFilter": "MipMapLinearLinear / Linear; original PNG unchanged; atlas padding retained",
  "font": "rasterize round(logicalSize*stageScale*framebufferRatio); font scale 1/framebufferRatio; never stretch X/Y independently",
