    {
      "z": 0,
      "name": "environment",
      "space": "window"
    },
    {
      "z": 10,
      "name": "table",
      "space": "stage"
    },
    {
      "z": 20,
      "name": "compass and public seats",
      "space": "stage"
    },
    {
      "z": 30,
      "name": "tiles after deal",
      "space": "stage"
    },
    {
      "z": 40,
      "name": "dock / drawer / receipt",
      "space": "stage, clipped"
    },
    {
      "z": 50,
      "name": "focus, selected border, text",
      "space": "stage"
    },
    {
      "z": 100,
      "name": "system dialogs",
      "space": "safe window"
    }
  ],
