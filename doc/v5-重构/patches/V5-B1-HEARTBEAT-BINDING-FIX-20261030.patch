diff --git a/dotnet/tests/Mahjong.P5.4b.B1.HttpsAdmission.Tests/HeartbeatLivenessGateTests.cs b/dotnet/tests/Mahjong.P5.4b.B1.HttpsAdmission.Tests/HeartbeatLivenessGateTests.cs
