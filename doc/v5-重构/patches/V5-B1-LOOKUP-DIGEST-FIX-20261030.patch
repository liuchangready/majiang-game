diff --git a/dotnet/tests/Mahjong.TableService.Tests/B1ReceiptDigestTests.cs b/dotnet/tests/Mahjong.TableService.Tests/B1ReceiptDigestTests.cs
new file mode 100644
index 0000000..07ad1a2
--- /dev/null
+++ b/dotnet/tests/Mahjong.TableService.Tests/B1ReceiptDigestTests.cs
@@ -0,0 +1,272 @@
+using System;
+using System.Threading.Tasks;
+using Mahjong.Contracts;
+using Mahjong.Contracts.Wire;
+using Mahjong.Domain;
+using Xunit;
+
+namespace Mahjong.TableService.Tests
+{
+    /// <summary>
+    /// B1-BLOCKER-03 regression matrix: a durable lookup for an APPLIED or REJECTED
+    /// receipt must return the original MJC1 canonical-payload digest (the same one the
+    /// immediate receipt carried), both on the inner receipt and on the lookup-level
+    /// field. The raw TablePayloadSha256 is a different domain and must never be
+    /// substituted. Same-key conflicts, scope isolation and UNKNOWN/NOT_FOUND semantics
+    /// stay unchanged.
+    /// </summary>
+    public sealed class B1ReceiptDigestTests
+    {
+        [Fact]
+        public async Task AppliedLookup_PreservesOriginalDigest_AndSameKeyConflictKeepsIt()
+        {
+            // A deterministic legal discard from the established claim-free fixture; this
+            // produces a real APPLIED commit and therefore a durable accepted receipt.
+            await using TableServiceTestHost host = await TableServiceTestHost.StartAsync(
+                o => { o.RoomTickIntervalMs = 50; },
+                roundSource: new FixedRoundSource(roomId =>
+                {
+                    var fixture = new N1aTable { Dealer = 0 };
+                    fixture.Hand(0, new[]
+                    {
+                        new TileId(108), new TileId(109), new TileId(110), new TileId(111),
+                        new TileId(112), new TileId(113), new TileId(114), new TileId(115),
+                        new TileId(116), new TileId(117), new TileId(118), new TileId(119),
+                        new TileId(120)
+                    });
+                    fixture.Drawn(0, new TileId(127));
+                    return fixture.Build(roomId + "-r1");
+                }));
+
+            await using TableTestClient client =
+                await host.ConnectPlayerAsync("room-b1-applied", "acct-b1-applied", 0);
+            Welcome welcome = client.Welcome!;
+            PlayerSnapshot snapshot = await ReadPlayerSnapshotAsync(
+                client,
+                value => value.PrivateView?.Decision != null);
+            Contracts.Wire.DecisionView decision = snapshot.PrivateView!.Decision!;
+
+            string requestId = TableWire.RandomId("req-b1-applied");
+            byte[] payload = TableWire.SubmitActionPayload(
+                snapshot.RoundId,
+                decision.DecisionId,
+                decision.ControlEpoch,
+                (uint)ProtocolActionType.DiscardTile,
+                new[] { decision.Actions[0].TileIds[0] });
+            string expectedDigest = CanonicalPayloadDigest.Compute(payload).ToHex();
+
+            await client.SendAsync(TableWire.Command(
+                welcome,
+                requestId,
+                Contracts.CommandKind.SubmitAction,
+                payload,
+                expectedStateVersion: snapshot.StateVersion));
+
+            Envelope immediate = await client.ReadUntilAsync(
+                envelope => envelope.MessageType == MessageType.Receipt &&
+                            envelope.RequestId == requestId,
+                TimeSpan.FromSeconds(20));
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Applied, immediate.Receipt.Status);
+            Assert.Equal(expectedDigest, immediate.Receipt.CanonicalPayloadSha256);
+
+            Envelope lookup = await QueryAsync(client, welcome, welcome.Scope.ScopeId, requestId);
+            Assert.True(lookup.ReceiptLookup.Receipt.Replayed);
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Applied, lookup.ReceiptLookup.Receipt.Status);
+            Assert.Equal(expectedDigest, lookup.ReceiptLookup.Receipt.CanonicalPayloadSha256);
+            Assert.Equal(expectedDigest, lookup.ReceiptLookup.CanonicalPayloadSha256);
+
+            // Same key, different original bytes is still a conflict and must not rewrite
+            // the original receipt or its canonical digest.
+            byte[] differentPayload = TableWire.SubmitActionPayload(
+                snapshot.RoundId,
+                decision.DecisionId,
+                decision.ControlEpoch,
+                (uint)ProtocolActionType.Pass);
+            await client.SendAsync(TableWire.Command(
+                welcome,
+                requestId,
+                Contracts.CommandKind.SubmitAction,
+                differentPayload,
+                expectedStateVersion: snapshot.StateVersion));
+
+            Envelope conflict = await client.ReadUntilAsync(
+                envelope => envelope.MessageType == MessageType.Error,
+                TimeSpan.FromSeconds(20));
+            Assert.Equal(ProtocolErrorCode.RequestIdConflict, conflict.Error.Code);
+            Assert.Equal("request_id", conflict.Error.FieldPath);
+
+            Envelope afterConflict = await QueryAsync(client, welcome, welcome.Scope.ScopeId, requestId);
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Applied, afterConflict.ReceiptLookup.Receipt.Status);
+            Assert.Equal(expectedDigest, afterConflict.ReceiptLookup.Receipt.CanonicalPayloadSha256);
+            Assert.Equal(expectedDigest, afterConflict.ReceiptLookup.CanonicalPayloadSha256);
+        }
+
+        [Fact]
+        public async Task RejectedLookup_PreservesOriginalDigest_AndUnknownResultStaysDigestFree()
+        {
+            await using TableServiceTestHost host = await TableServiceTestHost.StartAsync();
+            await using TableTestClient client =
+                await host.ConnectPlayerAsync("room-b1-rejected", "acct-b1-rejected", 0);
+            Welcome welcome = client.Welcome!;
+
+            string requestId = TableWire.RandomId("req-b1-rejected");
+            // A shape-valid command whose round is not the authoritative round is rejected
+            // before Domain evaluation and persisted as a definitive REJECTED receipt.
+            byte[] payload = TableWire.SubmitActionPayload(
+                "round-b1-does-not-exist",
+                "decision-b1-does-not-exist",
+                0,
+                (uint)ProtocolActionType.DrawTile);
+            string expectedDigest = CanonicalPayloadDigest.Compute(payload).ToHex();
+
+            await client.SendAsync(TableWire.Command(
+                welcome,
+                requestId,
+                Contracts.CommandKind.SubmitAction,
+                payload));
+
+            Envelope immediate = await client.ReadUntilAsync(
+                envelope => envelope.MessageType == MessageType.Receipt &&
+                            envelope.RequestId == requestId,
+                TimeSpan.FromSeconds(20));
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Rejected, immediate.Receipt.Status);
+            Assert.Equal("ROUND_MISMATCH", immediate.Receipt.ReasonCode);
+            Assert.Equal(expectedDigest, immediate.Receipt.CanonicalPayloadSha256);
+
+            Envelope lookup = await QueryAsync(client, welcome, welcome.Scope.ScopeId, requestId);
+            Assert.True(lookup.ReceiptLookup.Receipt.Replayed);
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Rejected, lookup.ReceiptLookup.Receipt.Status);
+            Assert.Equal("ROUND_MISMATCH", lookup.ReceiptLookup.Receipt.ReasonCode);
+            Assert.Equal(expectedDigest, lookup.ReceiptLookup.Receipt.CanonicalPayloadSha256);
+            Assert.Equal(expectedDigest, lookup.ReceiptLookup.CanonicalPayloadSha256);
+
+            // Same key, different bytes remains a conflict; the original REJECTED receipt
+            // and its identity are preserved.
+            byte[] differentPayload = TableWire.SubmitActionPayload(
+                "round-b1-does-not-exist",
+                "decision-b1-does-not-exist",
+                0,
+                (uint)ProtocolActionType.Pass);
+            await client.SendAsync(TableWire.Command(
+                welcome,
+                requestId,
+                Contracts.CommandKind.SubmitAction,
+                differentPayload));
+
+            Envelope conflict = await client.ReadUntilAsync(
+                envelope => envelope.MessageType == MessageType.Error,
+                TimeSpan.FromSeconds(20));
+            Assert.Equal(ProtocolErrorCode.RequestIdConflict, conflict.Error.Code);
+
+            Envelope afterConflict = await QueryAsync(client, welcome, welcome.Scope.ScopeId, requestId);
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Rejected, afterConflict.ReceiptLookup.Receipt.Status);
+            Assert.Equal(expectedDigest, afterConflict.ReceiptLookup.Receipt.CanonicalPayloadSha256);
+
+            // UNKNOWN/NOT_FOUND never prove non-commit and never carry an invented digest.
+            Envelope unknown = await QueryAsync(
+                client,
+                welcome,
+                welcome.Scope.ScopeId,
+                TableWire.RandomId("req-b1-missing"));
+            Assert.Equal(LookupStatus.NotFound, unknown.ReceiptLookup.Status);
+            Assert.Null(unknown.ReceiptLookup.Receipt);
+            Assert.Equal(string.Empty, unknown.ReceiptLookup.CanonicalPayloadSha256);
+        }
+
+        [Fact]
+        public async Task LookupScopeIsolation_AndSameAccountHistoricalScopePreservesDigest()
+        {
+            await using TableServiceTestHost host = await TableServiceTestHost.StartAsync();
+            string oldScope;
+            string requestId;
+            string expectedDigest;
+            await using (TableTestClient owner =
+                await host.ConnectPlayerAsync("room-b1-scope", "acct-b1-scope-a", 0))
+            {
+                oldScope = owner.Welcome!.Scope.ScopeId;
+                requestId = TableWire.RandomId("req-b1-scope");
+                byte[] payload = TableWire.SubmitActionPayload(
+                    "round-b1-scope-missing",
+                    "decision-b1-scope-missing",
+                    0,
+                    (uint)ProtocolActionType.DrawTile);
+                expectedDigest = CanonicalPayloadDigest.Compute(payload).ToHex();
+                await owner.SendAsync(TableWire.Command(
+                    owner.Welcome,
+                    requestId,
+                    Contracts.CommandKind.SubmitAction,
+                    payload));
+                Envelope receipt = await owner.ReadUntilAsync(
+                    envelope => envelope.MessageType == MessageType.Receipt &&
+                                envelope.RequestId == requestId,
+                    TimeSpan.FromSeconds(20));
+                Assert.Equal(Contracts.Wire.ReceiptStatus.Rejected, receipt.Receipt.Status);
+                Assert.Equal(expectedDigest, receipt.Receipt.CanonicalPayloadSha256);
+            }
+
+            // A different account cannot read the historical scope.
+            await using (TableTestClient other =
+                await host.ConnectPlayerAsync("room-b1-scope", "acct-b1-scope-b", 1))
+            {
+                await other.SendAsync(TableWire.ReceiptQuery(
+                    other.Welcome!, oldScope, requestId));
+                Envelope foreign = await other.ReadUntilAsync(
+                    envelope => envelope.MessageType == MessageType.Error,
+                    TimeSpan.FromSeconds(20));
+                Assert.Equal(ProtocolErrorCode.MalformedMessage, foreign.Error.Code);
+                Assert.Equal("SCOPE_MISMATCH", foreign.Error.DetailCode);
+
+                // The other account's OWN scope cannot see the request id by key isolation.
+                Envelope ownScope = await QueryAsync(
+                    other,
+                    other.Welcome!,
+                    other.Welcome!.Scope.ScopeId,
+                    requestId);
+                Assert.Equal(LookupStatus.NotFound, ownScope.ReceiptLookup.Status);
+                Assert.Null(ownScope.ReceiptLookup.Receipt);
+                Assert.Equal(string.Empty, ownScope.ReceiptLookup.CanonicalPayloadSha256);
+            }
+
+            // The same account/room/role reconnecting on a fresh scope may reconcile the
+            // original historical scope, and still receives the original digest.
+            await using TableTestClient reopened =
+                await host.ConnectPlayerAsync("room-b1-scope", "acct-b1-scope-a", 0);
+            Envelope historical = await QueryAsync(
+                reopened,
+                reopened.Welcome!,
+                oldScope,
+                requestId);
+            Assert.Equal(LookupStatus.Found, historical.ReceiptLookup.Status);
+            Assert.Equal(Contracts.Wire.ReceiptStatus.Rejected, historical.ReceiptLookup.Receipt.Status);
+            Assert.Equal(expectedDigest, historical.ReceiptLookup.Receipt.CanonicalPayloadSha256);
+            Assert.Equal(expectedDigest, historical.ReceiptLookup.CanonicalPayloadSha256);
+        }
+
+        private static async Task<Envelope> QueryAsync(
+            TableTestClient client,
+            Welcome welcome,
+            string scopeId,
+            string requestId)
+        {
+            Envelope query = TableWire.ReceiptQuery(welcome, scopeId, requestId);
+            query.CorrelationId = "corr-b1-" + requestId;
+            await client.SendAsync(query);
+            return await client.ReadUntilAsync(
+                envelope => envelope.MessageType == MessageType.ReceiptLookup &&
+                            envelope.RequestId == requestId,
+                TimeSpan.FromSeconds(20));
+        }
+
+        private static async Task<PlayerSnapshot> ReadPlayerSnapshotAsync(
+            TableTestClient client,
+            Func<PlayerSnapshot, bool> predicate)
+        {
+            Envelope envelope = await client.ReadUntilAsync(
+                item => item.MessageType == MessageType.PlayerUpdate &&
+                        item.PlayerUpdate.Snapshot.PrivateView != null &&
+                        predicate(item.PlayerUpdate.Snapshot),
+                TimeSpan.FromSeconds(20));
+            return envelope.PlayerUpdate.Snapshot;
+        }
+    }
+}
