diff --git a/dotnet/tests/Mahjong.TableRuntime.Tests/B1ReceiptDigestPersistenceTests.cs b/dotnet/tests/Mahjong.TableRuntime.Tests/B1ReceiptDigestPersistenceTests.cs
new file mode 100644
index 0000000..b0cf835
--- /dev/null
+++ b/dotnet/tests/Mahjong.TableRuntime.Tests/B1ReceiptDigestPersistenceTests.cs
@@ -0,0 +1,105 @@
+using System.Text;
+using System.Threading.Tasks;
+using Mahjong.Contracts;
+using Mahjong.Domain;
+using Xunit;
+
+namespace Mahjong.TableRuntime.Tests
+{
+    /// <summary>
+    /// B1-BLOCKER-03 persistence regression: the MJC1 canonical digest carried by the
+    /// trusted host must reach the durable APPLIED/REJECTED receipt and remain readable by
+    /// a fresh actor after cold recovery from the same durable store. The raw
+    /// TablePayloadSha256 is a separate idempotency identity and is not substituted.
+    /// </summary>
+    public sealed class B1ReceiptDigestPersistenceTests
+    {
+        [Fact]
+        public async Task AppliedAndRejectedLookupDigestsSurviveActorRecovery()
+        {
+            await using DurableHarness harness = await DurableHarness.CreateAsync();
+            RoundStateMachine round = harness.InitialRound;
+
+            // REJECTED first: a wrong-seat discard against the still-initial round.
+            int wrongSeat = (round.CurrentSeat + 1) % 4;
+            TileId wrongTile = round.Tiles.TilesInZone(TileZone.Hand, wrongSeat)[0];
+            string rejectedPayload = "b1-rejected-canonical-payload";
+            PayloadDigest rejectedDigest = CanonicalPayloadDigest.Compute(
+                Encoding.UTF8.GetBytes(rejectedPayload));
+            TableCommandEnvelope rejected = harness.Envelope(
+                RoundCommand.Discard(round.RoundId, wrongSeat, wrongTile),
+                0,
+                "b1-rejected",
+                payloadText: rejectedPayload,
+                canonicalPayloadDigest: rejectedDigest);
+            TableOperationResult rejection = await harness.SubmitAsync(rejected);
+            Assert.Equal(TableOperationStatus.Rejected, rejection.Status);
+            Assert.Equal(rejectedDigest, rejection.DurableReceipt!.Receipt.CanonicalPayloadDigest);
+
+            // APPLIED after the rejection: the rejection did not consume a state version.
+            string appliedPayload = "b1-applied-canonical-payload";
+            PayloadDigest appliedDigest = CanonicalPayloadDigest.Compute(
+                Encoding.UTF8.GetBytes(appliedPayload));
+            TableCommandEnvelope applied = harness.Envelope(
+                P31Fixtures.DiscardCurrent(round),
+                0,
+                "b1-applied",
+                payloadText: appliedPayload,
+                canonicalPayloadDigest: appliedDigest);
+            TableOperationResult accepted = await harness.SubmitAsync(applied);
+            Assert.Equal(TableOperationStatus.Accepted, accepted.Status);
+            Assert.Equal(appliedDigest, accepted.DurableReceipt!.Receipt.CanonicalPayloadDigest);
+
+            ReceiptLookupResult appliedLookup = await harness.Actor.QueryReceiptAsync(
+                DurableHarness.Account,
+                harness.Scope.ScopeId,
+                applied.RequestId,
+                TestContext.Current.CancellationToken);
+            Assert.True(appliedLookup.IsDefinitive);
+            Assert.Equal(appliedDigest, appliedLookup.Receipt!.CanonicalPayloadDigest);
+            Assert.Equal(appliedDigest, appliedLookup.Digest);
+
+            ReceiptLookupResult rejectedLookup = await harness.Actor.QueryReceiptAsync(
+                DurableHarness.Account,
+                harness.Scope.ScopeId,
+                rejected.RequestId,
+                TestContext.Current.CancellationToken);
+            Assert.True(rejectedLookup.IsDefinitive);
+            Assert.Equal(ReceiptStatus.Rejected, rejectedLookup.Receipt!.Status);
+            Assert.Equal(rejectedDigest, rejectedLookup.Receipt.CanonicalPayloadDigest);
+            Assert.Equal(rejectedDigest, rejectedLookup.Digest);
+
+            // Cold recovery through a NEW actor instance reading the same durable store.
+            // This is not a process/PostgreSQL restart; it proves the digest is stored, not
+            // held only in the original actor object.
+            await harness.CloseAsync();
+            await using DurableHarness restarted = DurableHarness.Attach(
+                harness,
+                DurableHarness.Owner,
+                1UL);
+            TableRecoveryResult recovery = await restarted.Actor.RecoverFromStoreAsync(
+                TestContext.Current.CancellationToken);
+            Assert.True(recovery.Recovered, recovery.ReasonCode + ": " + recovery.Detail);
+
+            ReceiptLookupResult recoveredApplied = await restarted.Actor.QueryReceiptAsync(
+                DurableHarness.Account,
+                harness.Scope.ScopeId,
+                applied.RequestId,
+                TestContext.Current.CancellationToken);
+            Assert.True(recoveredApplied.IsDefinitive);
+            Assert.Equal(ReceiptStatus.Applied, recoveredApplied.Receipt!.Status);
+            Assert.Equal(appliedDigest, recoveredApplied.Receipt.CanonicalPayloadDigest);
+            Assert.Equal(appliedDigest, recoveredApplied.Digest);
+
+            ReceiptLookupResult recoveredRejected = await restarted.Actor.QueryReceiptAsync(
+                DurableHarness.Account,
+                harness.Scope.ScopeId,
+                rejected.RequestId,
+                TestContext.Current.CancellationToken);
+            Assert.True(recoveredRejected.IsDefinitive);
+            Assert.Equal(ReceiptStatus.Rejected, recoveredRejected.Receipt!.Status);
+            Assert.Equal(rejectedDigest, recoveredRejected.Receipt.CanonicalPayloadDigest);
+            Assert.Equal(rejectedDigest, recoveredRejected.Digest);
+        }
+    }
+}
