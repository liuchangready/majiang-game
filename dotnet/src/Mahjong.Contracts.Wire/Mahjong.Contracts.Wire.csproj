<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Mahjong.Contracts.Wire</AssemblyName>
    <RootNamespace>Mahjong.Contracts.Wire</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Protobuf_UseGrpcTools>true</Protobuf_UseGrpcTools>
  </PropertyGroup>

  <!--
    Protocol v1 wire schema. `mahjong.proto` is the single source of truth for
    field numbers, reserved ranges and oneofs; C# is generated by Grpc.Tools on
    every build. Do not check generated files in and do not hand-edit them.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="mahjong.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mahjong.Contracts\Mahjong.Contracts.csproj" />
  </ItemGroup>

</Project>
