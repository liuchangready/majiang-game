<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P5.2 server-only PostgreSQL infrastructure. Shared libraries remain
    netstandard2.1/C# 9; this service-side project targets .NET 8 and is not
    referenced by Domain/Contracts/Client/LocalHost/Unity.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>Mahjong.Infrastructure</AssemblyName>
    <RootNamespace>Mahjong.Infrastructure</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mahjong.TableRuntime\Mahjong.TableRuntime.csproj" />
    <ProjectReference Include="..\Mahjong.Contracts\Mahjong.Contracts.csproj" />
    <ProjectReference Include="..\Mahjong.Domain\Mahjong.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\001_table_store.sql" />
  </ItemGroup>

</Project>
