{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Lobby": {
    "StorageProvider": "Memory",
    "AutoMigrate": false,
    "AllowInMemoryStorageInProduction": false,
    "SessionTtlHours": 24,
    "GuestAccountRetentionDays": 7,
    "ReceiptRetentionDays": 7,
    "TicketTtlSeconds": 60,
    "TicketMaxTtlSeconds": 300,
    "ClockSkewSeconds": 5,
    "ReservationTtlSeconds": 15,
    "QueueTtlSeconds": 120,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "MaintenanceIntervalSeconds": 1,
    "MaxSpectatorsPerRoom": 32,
    "MatchingEnabled": true,
    "AllowGuestRankedMatch": false,
    "ProductDecisionAcknowledged": false,
    "MatchRule": "FIFO_TABLE_FILL_V1_TEMPORARY",
    "SpectatorDelaySeconds": 0,
    "ProjectionSchema": "table_runtime",
    "OidcEnabled": false,
    "TicketIssuer": "mahjong-lobby",
    "TicketAudience": "mahjong-table"
  }
}
