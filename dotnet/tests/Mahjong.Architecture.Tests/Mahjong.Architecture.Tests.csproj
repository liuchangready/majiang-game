<Project Sdk="Microsoft.NET.Sdk">

  <!--
    V5 module dependency-direction guard (accepted I-5 / S-1).

    This project is a test-only consumer of the ten production assemblies. It is
    deliberately NOT added to Mahjong.sln and does not modify any production csproj,
    the unified verify script, fixtures or an existing test project: tools/verify-v5.ps1
    auto-discovers every *.Tests project under dotnet/tests (header lines 6-8, glob
    patterns at lines 564-568), so this project is picked up without those edits.

    It reads the production project declarations (XML) and the production assemblies
    (System.Reflection.Metadata) directly; it never inspects its own references.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mahjong.Architecture.Tests</AssemblyName>
    <RootNamespace>Mahjong.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same xUnit v3 version as every other test executable in this tree. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References exist only to force a fresh Release build of all ten production
      projects before this test executable runs. The guard reads their bin/Release
      outputs and project files, not the test project's own reference closure.
    -->
    <ProjectReference Include="..\..\src\Mahjong.Domain\Mahjong.Domain.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts\Mahjong.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts.Wire\Mahjong.Contracts.Wire.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Ai\Mahjong.Ai.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.TableRuntime\Mahjong.TableRuntime.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Client\Mahjong.Client.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.LocalHost\Mahjong.LocalHost.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.LobbyService\Mahjong.LobbyService.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.TableService\Mahjong.TableService.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Infrastructure\Mahjong.Infrastructure.csproj" />
  </ItemGroup>

</Project>
