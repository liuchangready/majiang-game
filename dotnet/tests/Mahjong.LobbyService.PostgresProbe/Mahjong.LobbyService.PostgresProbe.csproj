<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone cross-process restart probe for the P5.3 lobby PostgreSQL store.
    It is NOT a test project and is NOT added to Mahjong.sln: the ordinary test
    assembly must have zero phase-only skips. scripts/pg-lobby-verify calls the
    built executable for the write/read phases around a real PostgreSQL restart.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mahjong.LobbyService.PostgresProbe</AssemblyName>
    <RootNamespace>Mahjong.LobbyService.PostgresProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Mahjong.LobbyService.Tests\LobbyFixture.cs" Link="LobbyFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mahjong.LobbyService\Mahjong.LobbyService.csproj" />
  </ItemGroup>

</Project>
