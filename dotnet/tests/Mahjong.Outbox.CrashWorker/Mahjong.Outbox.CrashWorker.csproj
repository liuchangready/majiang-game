<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only crash worker for P5.4a. It is deliberately not part of
    Mahjong.sln; Mahjong.Client.Tests references it for build and copies its
    output next to the test assembly. No production entry point, no network.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mahjong.Outbox.CrashWorker</AssemblyName>
    <RootNamespace>Mahjong.Outbox.CrashWorker</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mahjong.Client\Mahjong.Client.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts\Mahjong.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts.Wire\Mahjong.Contracts.Wire.csproj" />
  </ItemGroup>

</Project>
