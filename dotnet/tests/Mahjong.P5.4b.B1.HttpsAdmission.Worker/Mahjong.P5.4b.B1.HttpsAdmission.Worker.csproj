<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P5.4b-B1 HTTPS Lobby -> WSS TableService admission/reconciliation worker.
    A plain console process driven by tools/ci/verify-v5-https-admission.ps1.
    It uses the REAL LobbyService over HTTPS and the REAL TableService over WSS;
    no in-process service substitute, no self-signed positive ticket, and no
    production source change. The only transport decorator is the explicit
    receipt-loss injector in ReceiptLossChannel.cs (documented injection point).

    Not registered in Mahjong.sln; the runner builds and executes this DLL
    directly. The strict trust and loss-decorator sources are shared with the
    focused B1 test project so both compile against the same policy.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Mahjong.P5.4b.B1.HttpsAdmission.Worker</AssemblyName>
    <RootNamespace>Mahjong.P5_4b.B1.HttpsAdmission.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mahjong.Client\Mahjong.Client.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts\Mahjong.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts.Wire\Mahjong.Contracts.Wire.csproj" />
  </ItemGroup>

</Project>
