<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Independent P3.1 test executable. It is deliberately NOT added to Mahjong.sln and does not
    modify the existing solution/verify scripts; run it directly with dotnet test on this csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mahjong.TableRuntime.Tests</AssemblyName>
    <RootNamespace>Mahjong.TableRuntime.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mahjong.TableRuntime\Mahjong.TableRuntime.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Domain\Mahjong.Domain.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Ai\Mahjong.Ai.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts\Mahjong.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts.Wire\Mahjong.Contracts.Wire.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Client\Mahjong.Client.csproj" />
  </ItemGroup>

</Project>
