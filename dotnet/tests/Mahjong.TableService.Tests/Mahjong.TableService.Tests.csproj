<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone P5.1 test project. It is intentionally not added to Mahjong.sln
    (solution edits are out of the receiver's scope); run it directly:
      dotnet test dotnet/tests/Mahjong.TableService.Tests/Mahjong.TableService.Tests.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mahjong.TableService.Tests</AssemblyName>
    <RootNamespace>Mahjong.TableService.Tests</RootNamespace>
    <!-- These tests drive explicit timing fixtures (handshake/idle deadlines). -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Mahjong.TableService\Mahjong.TableService.csproj" />
    <ProjectReference Include="..\..\src\Mahjong.Contracts\Mahjong.Contracts.csproj" />
  </ItemGroup>

</Project>
